@inject Random Rando
@rendermode InteractiveServer

<div class="controller">
    @foreach (Counter counter in counters)
    {
        <Counter @ref="counters[counters.IndexOf(counter)]" ID="counters.IndexOf(counter)" />
    }
</div>
<input type="number" placeholder="?" @bind-value=Guess />
<button @onclick=TryGuess>Submit</button>
<button @onclick=PresentRandom >Show Random!</button>

<script>

    window.addEventListener('resize', function (event) {
        location.reload();
    });

</script>

@code {
    public int DisplayValue { get; set; }
    [Parameter]
    public int Start { get; set; }
    [Parameter]
    public int End { get; set; }
    private int Guess;

    private List<Counter> counters = new List<Counter>();

    protected override void OnParametersSet()
    {
        DisplayValue = Rando.Next(Start, End + 1);
        int sizeCounters = (int)Math.Ceiling(DisplayValue / 10.0);

        counters = new List<Counter>();
        for (int i = 0; i < sizeCounters; i++)
        {
            counters.Add(new Counter());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            await PresentRandom();
        }
    }

    public async Task PresentRandom()
    {
        //fresh start?        
        int addAmount = DisplayValue;
        while (addAmount > 0)
        {
            if (counters != null)
            {
                int iterations = counters.Count;
                for (int j = 0; j < iterations; j++)
                {
                    addAmount = counters[j].AddReturnRemainder(addAmount, false);
                    if (addAmount == 0) break;
                    else if (j == counters.Count - 1)
                    {
                        Counter newcounter = new Counter();
                        counters.Add(newcounter);
                        //
                        while (!counters[iterations].IsRendered)
                        {
                            await Task.Delay(250);
                        }
                        iterations++;

                    }
                }
            }
        }
        StateHasChanged();
    }

    public async Task TryGuess()
    {
        if (Guess == DisplayValue)
        {
            string test = "here";
        }
        else
        {
            string miss = "here";
        }
    }
}